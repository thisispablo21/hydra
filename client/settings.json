{
  "autoUpdatesChannel": "latest",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd __HYDRA_REPO_PATH__ && git pull --ff-only 2>/dev/null && bash client/setup.sh 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python -m hydra_cli sync --pull --cwd \"${CLAUDE_PROJECT_DIR:-$PWD}\" >/dev/null 2>&1 || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -m hydra_cli commands pull >/dev/null 2>&1 || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -m hydra_cli skills pull --harness claude-code >/dev/null 2>&1 || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -m hydra_cli event || exit 1",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m hydra_cli usage report 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -m hydra_cli event || exit 1",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m hydra_cli event || exit 1",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -m hydra_cli event || exit 1",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -m hydra_cli guard",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m hydra_cli capture-remote-url; [ $? = 1 ] && exit 1; exit 0",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -m hydra_cli usage report 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python -m hydra_cli event || exit 1",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m hydra_cli event || exit 1",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m hydra_cli event || exit 1",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python -m hydra_cli event || exit 1",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
